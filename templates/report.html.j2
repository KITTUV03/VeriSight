{# VeriSight HTML Report Template #}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VeriSight Report — {{ session_id }}</title>
    <style>
        :root { --bg:#0d1117; --card:#161b22; --border:#30363d; --text:#c9d1d9; --muted:#8b949e; --accent:#58a6ff; --err:#f85149; --warn:#d29922; --ok:#3fb950; }
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:var(--bg);color:var(--text);line-height:1.6;padding:2rem;max-width:1200px;margin:0 auto}
        h1{color:var(--accent);margin-bottom:.5rem}h2{color:var(--accent);margin:2rem 0 1rem;padding-bottom:.5rem;border-bottom:1px solid var(--border)}
        .meta{color:var(--muted);margin-bottom:2rem}
        .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1rem;margin:1rem 0 2rem}
        .card{background:var(--card);border:1px solid var(--border);border-radius:8px;padding:1rem}
        .card .l{color:var(--muted);font-size:.85rem}.card .v{font-size:1.3rem;font-weight:700;margin-top:.3rem}
        table{width:100%;border-collapse:collapse;margin:1rem 0;background:var(--card)}
        th,td{padding:.5rem 1rem;text-align:left;border-bottom:1px solid var(--border)}th{color:var(--muted)}
        .item{background:var(--card);border:1px solid var(--border);border-radius:6px;padding:.8rem;margin:.5rem 0}
        pre{background:#0d1117;border:1px solid var(--border);padding:.5rem;border-radius:4px;margin-top:.5rem;overflow-x:auto}
        code{color:#79c0ff;font-family:monospace}
        footer{margin-top:3rem;padding-top:1rem;border-top:1px solid var(--border);color:var(--muted);font-size:.85rem}
    </style>
</head>
<body>
    <h1>🔍 VeriSight Debugging Report</h1>
    <div class="meta">Session: {{ session_id }} • Generated: {{ timestamp }} • Simulation: {{ simulation_status }} ({{ simulation_time }})</div>
    <div class="grid">
        <div class="card"><div class="l">Classification</div><div class="v">{{ report.classification }}</div></div>
        <div class="card"><div class="l">Confidence</div><div class="v">{{ report.confidence }}%</div></div>
        <div class="card"><div class="l">Module</div><div class="v">{{ report.module or 'N/A' }}</div></div>
        <div class="card"><div class="l">Category</div><div class="v">{{ report.category or 'N/A' }}</div></div>
        <div class="card"><div class="l">Severity</div><div class="v">{{ report.severity }}</div></div>
        <div class="card"><div class="l">Errors</div><div class="v" style="color:var(--err)">{{ error_count }}</div></div>
    </div>
    <div class="item" style="border-left:4px solid var(--err)"><h3>Root Cause</h3><p>{{ report.root_cause }}</p>
        {% if report.affected_signals %}<p><strong>Affected:</strong> {% for s in report.affected_signals %}<code>{{ s }}</code> {% endfor %}</p>{% endif %}
    </div>
    <h2>Error Timeline</h2>
    <table><thead><tr><th>Time</th><th>Severity</th><th>Message</th></tr></thead><tbody>
        {% for e in errors %}<tr><td>{{ e.timestamp }}</td><td>{{ e.severity }}</td><td>{{ e.message[:100] }}</td></tr>{% endfor %}
    </tbody></table>
    {% if report.evidence %}<h2>Evidence</h2>{% for ev in report.evidence %}<div class="item"><strong>[{{ ev.source }}]</strong> {{ ev.reference }} — {{ ev.description }}</div>{% endfor %}{% endif %}
    {% if report.recommended_fixes %}<h2>Fixes</h2>{% for f in report.recommended_fixes %}<div class="item"><strong>[{{ f.priority }}]</strong> {{ f.action }}{% if f.code_suggestion %}<pre><code>{{ f.code_suggestion }}</code></pre>{% endif %}</div>{% endfor %}{% endif %}
    <footer>Generated by VeriSight v1.0.0</footer>
</body>
</html>
