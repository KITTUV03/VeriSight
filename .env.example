# VeriSight Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider API Key (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override LLM model name
# VERISIGHT_MODEL=gemini-2.0-flash

# Optional: ChromaDB persistence path
# VERISIGHT_CHROMA_PATH=./verisight_knowledge_db

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# VERISIGHT_LOG_LEVEL=INFO
