# VeriSight Environment Configuration
# Copy this file to .env and fill in your values

# LLM Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Override LLM provider (gemini or anthropic)
# VERISIGHT_PROVIDER=anthropic

# Optional: Override LLM model name (e.g. gemini-2.0-flash or claude-sonnet-4-20250514)
# VERISIGHT_MODEL=claude-sonnet-4-20250514

# Optional: ChromaDB persistence path
# VERISIGHT_CHROMA_PATH=./verisight_knowledge_db

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
# VERISIGHT_LOG_LEVEL=INFO

# Optional: Path to x-tracer's x_tracer.py, for real X-propagation tracing
# (see "X-Propagation Analysis (x-tracer)" in README.md). Not needed unless
# you pass --xtrace.
# VERISIGHT_XTRACER_PATH=/path/to/x-tracer/x_tracer.py
